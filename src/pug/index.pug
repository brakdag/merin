mixin icon(name)
    svg.icon(viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.7', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
        if name === 'arrow'
            path(d='M4 12h15M13 5l7 7-7 7')
        else if name === 'external'
            path(d='M7 17 17 7M6 7h11v11')
        else if name === 'book'
            path(d='M12 6c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V5c-4-1-7-1-10 1Zm0 0v15')
        else if name === 'users'
            circle(cx='9', cy='7', r='3')
            path(d='M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 5v3')
        else if name === 'pin'
            path(d='M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z')
            circle(cx='12', cy='10', r='2.5')
        else if name === 'phone'
            path(d='m5 3 4 4-2 3a16 16 0 0 0 7 7l3-2 4 4-2 3C10 23 1 14 2 5Z')
        else if name === 'tool'
            path(d='m14 7 3 3 5-5a7 7 0 0 1-9 9l-7 7a3 3 0 0 1-4-4l7-7a7 7 0 0 1 9-9Z')
        else if name === 'chevron'
            path(d='m6 9 6 6 6-6')

doctype html
html(lang='es-AR')
    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1')
        meta(name='description', content='Escuela Técnica N.º 4-124 Reynaldo Merín, en San Rafael, Mendoza. Conocé nuestra comunidad, accedé a la biblioteca digital y encontrá nuestros datos de contacto.')
        meta(name='theme-color', content='#202a28')
        meta(property='og:type', content='website')
        meta(property='og:locale', content='es_AR')
        meta(property='og:title', content='Escuela Técnica Reynaldo Merín')
        meta(property='og:description', content='Aprender, hacer y transformar. Conocé nuestra escuela en San Rafael, Mendoza.')
        meta(property='og:url', content='https://merin.edu.ar/')
        meta(property='og:image', content='https://merin.edu.ar/assets/img/escuela-poster.webp')
        title Escuela Técnica Reynaldo Merín | San Rafael, Mendoza
        link(rel='canonical', href='https://merin.edu.ar/')
        link(rel='icon', type='image/webp', href='assets/img/escudo.webp')
        link(rel='preload', as='image', href='assets/img/escuela-poster.webp', fetchpriority='high')
        link(rel='stylesheet', href='css/styles.css')
        noscript
            style.
                .site-header { position: relative; top: auto; padding-block: 16px; background: var(--ink); }
        script(src='js/scripts.js', defer)
    body#page-top
        a.skip-link(href='#contenido') Saltar al contenido
        header.site-header
            nav.nav.container(aria-label='Navegación principal')
                a.brand(href='#page-top')
                    img(src='assets/img/escudo.webp', width='52', height='52', alt='')
                    span.brand-text
                        strong Reynaldo Merín
                        small ESCUELA TÉCNICA N.º 4-124
                button.menu-toggle(type='button', aria-expanded='false', aria-controls='main-menu', hidden)
                    span Menú
                    span.menu-bars(aria-hidden='true')
                #main-menu.nav-links
                    a(href='#portfolio') La escuela
                    a(href='#biblioteca') Biblioteca
                    a(href='#about') Estudiantes
                    a.nav-contact(href='#contact')
                        | Contactanos
                        +icon('external')
        main#contenido(tabindex='-1')
            section.hero(aria-labelledby='hero-title')
                img.hero-poster(src='assets/img/escuela-poster.webp', width='1280', height='720', alt='', fetchpriority='high')
                video#background-video.hero-video(loop, muted, playsinline, preload='none', aria-hidden='true', tabindex='-1', data-desktop='assets/escuela-desktop.mp4', data-mobile='assets/escuela-mobile.mp4')
                .hero-shade
                .hero-content.container
                    p.eyebrow.hero-eyebrow
                        span.status-dot(aria-hidden='true')
                        | San Rafael, Mendoza
                    h1#hero-title Aprender.
                        br
                        | Hacer.
                        br
                        em Transformar.
                    p.hero-description Somos la Escuela Técnica Reynaldo Merín. Un lugar para descubrir lo que podés hacer y construir lo que viene.
                    a.button.button-yellow(href='#portfolio')
                        | Conocé nuestra escuela
                        +icon('arrow')
                .hero-bottom.container
                    a.hero-scroll(href='#portfolio')
                        span.scroll-line(aria-hidden='true')
                        | Una escuela, muchas posibilidades
                    button#video-toggle.video-toggle(type='button', hidden)
                        span.video-symbol(aria-hidden='true') ▶
                        span.video-label Reproducir video
            .quick-links.container(aria-label='Accesos rápidos')
                a.quick-link(href='#biblioteca')
                    +icon('book')
                    span
                        small PARA SEGUIR APRENDIENDO
                        strong Biblioteca digital
                    +icon('external')
                a.quick-link(href='#about')
                    +icon('users')
                    span
                        small TU VOZ EN LA ESCUELA
                        strong Centro de estudiantes
                    +icon('arrow')
                a.quick-link(href='#contact')
                    +icon('pin')
                    span
                        small ESTAMOS CERCA
                        strong Encontranos
                    +icon('arrow')
            section#portfolio.section.school-section
                .container
                    .section-heading
                        div
                            p.eyebrow 01 / NUESTRA ESCUELA
                            h2 El futuro se construye
                                br
                                em aprendiendo.
                        p.section-intro Somos una comunidad educativa de San Rafael. Creemos en el valor de aprender haciendo, compartir conocimientos y crecer junto a otros.
                    .values-grid
                        article.value
                            span.value-icon
                                +icon('tool')
                            h3 Aprender haciendo
                            p El aula y el taller se encuentran. La formación técnica conecta los conocimientos con la práctica y los desafíos del mundo que nos rodea.
                        article.value
                            span.value-icon
                                +icon('users')
                            h3 Crecer en comunidad
                            p Estudiantes, docentes y familias forman parte de la escuela. Un espacio de encuentro, participación y construcción compartida.
                        article.value
                            span.value-icon
                                +icon('book')
                            h3 Abrir nuevas puertas
                            p La lectura, la curiosidad y el intercambio de ideas nos ayudan a desarrollar una mirada propia y seguir aprendiendo.
            section#biblioteca.section.library-section(aria-labelledby='library-title')
                .container.library-grid
                    .library-image
                        img(src='assets/img/biblioteca.webp', alt='Estantes y libros de la biblioteca escolar', width='640', height='426', loading='lazy', decoding='async')
                        span.image-label Un mundo por descubrir
                    .library-content
                        p.eyebrow 02 / BIBLIOTECA DIGITAL
                        h2#library-title Tu próxima idea
                            br
                            em empieza acá.
                        p Un espacio para leer, investigar y encontrar nuevas preguntas. Accedé a la biblioteca digital de la escuela y acompañá tu aprendizaje dentro y fuera del aula.
                        a.button.button-dark(href='https://sites.google.com/view/bibliotecaescuelareynaldomern/biblioteca-digital', target='_blank', rel='noopener noreferrer')
                            | Explorar la biblioteca
                            +icon('external')
                            span.sr-only (abre en una pestaña nueva)
                        span.link-note Recursos para acompañar tus clases.
            section#about.section.students-section
                span#CEM.anchor-alias(aria-hidden='true')
                .container.students-grid
                    .students-content
                        p.eyebrow 03 / CENTRO DE ESTUDIANTES MERÍN
                        h2 La escuela también
                            br
                            em se hace con tu voz.
                        p El CEM es el espacio de representación y participación de los estudiantes. Un puente para compartir ideas, impulsar iniciativas y construir juntos la vida escolar.
                        ul.student-topics
                            li
                                span 01
                                | Participación y diálogo
                            li
                                span 02
                                | Propuestas y proyectos compartidos
                            li
                                span 03
                                | Compañerismo y solidaridad
                        a.text-link(href='https://www.instagram.com/escuelareynaldomerin/', target='_blank', rel='noopener noreferrer')
                            | Seguí la vida de la escuela
                            +icon('external')
                            span.sr-only en Instagram (abre en una pestaña nueva)
                    figure.students-image
                        img(src='assets/img/comunidad.webp', alt='Manos soldando componentes electrónicos durante una práctica de taller', width='960', height='540', loading='lazy', decoding='async')
                        figcaption Más que un lugar para estudiar. Un lugar para crecer.
            section#contact.section.contact-section
                .container
                    .section-heading
                        div
                            p.eyebrow 04 / CONTACTO
                            h2 Hablemos.
                        p.section-intro ¿Querés conocer más sobre la escuela o hacer una consulta? Comunicate con nosotros o acercate a visitarnos.
                    .contact-grid
                        .contact-details
                            .contact-item
                                +icon('pin')
                                div
                                    h3 Vení a conocernos
                                    address Av. Alberdi 1270, San Rafael
                                        br
                                        | Mendoza, Argentina · CP 5600
                                    a.text-link(href='https://www.google.com/maps/dir/?api=1&destination=Escuela+4-124+Reynaldo+Merin+Alberdi+1270+San+Rafael', target='_blank', rel='noopener noreferrer')
                                        | Cómo llegar
                                        +icon('external')
                                        span.sr-only (abre Google Maps en una pestaña nueva)
                            .contact-item
                                +icon('phone')
                                div
                                    h3 Llamanos
                                    a.phone-link(href='tel:+542604433178') 2604 433178
                                    a.phone-link(href='tel:+542604842746') 2604 842746
                            .social-links(aria-label='Redes de la escuela')
                                a(href='https://www.facebook.com/Comunidad-Reynaldo-Merin-575021779836346', target='_blank', rel='noopener noreferrer') Facebook ↗
                                    span.sr-only (abre en una pestaña nueva)
                                a(href='https://www.instagram.com/escuelareynaldomerin/', target='_blank', rel='noopener noreferrer') Instagram · @escuelareynaldomerin ↗
                                    span.sr-only (abre en una pestaña nueva)
                                a(href='https://www.youtube.com/watch?v=G5y7DZFWh6A', target='_blank', rel='noopener noreferrer') YouTube ↗
                                    span.sr-only (abre en una pestaña nueva)
                        .map-panel#map-panel
                            .map-pattern(aria-hidden='true')
                            .map-placeholder
                                span.map-pin
                                    +icon('pin')
                                strong Nos encontrás en San Rafael
                                p Av. Alberdi 1270 · Mendoza
                                button#load-map.button.button-dark(type='button', hidden, data-src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3282.890896791814!2d-68.31915063921433!3d-34.63219730888914!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9679a93a8e922add%3A0xc95424173bfe7cf4!2sEscuela%204-124%20Reynaldo%20Mer%C3%ADn!5e0!3m2!1ses-419!2sar!4v1686746893979!5m2!1ses-419!2sar')
                                    | Ver mapa interactivo
                                    +icon('external')
                                a.map-fallback(href='https://www.google.com/maps/search/?api=1&query=Escuela+4-124+Reynaldo+Merin+San+Rafael', target='_blank', rel='noopener noreferrer') Abrir en Google Maps ↗
                                    span.sr-only (abre en una pestaña nueva)
                            p#map-status.sr-only(role='status')
                    .faq
                        h3 Algunas consultas frecuentes
                        details
                            summary
                                | ¿Dónde consulto por inscripciones y documentación?
                                +icon('chevron')
                            p Comunicate con la escuela a los teléfonos publicados o acercate a Av. Alberdi 1270. Allí podrás consultar los requisitos, las fechas y la disponibilidad actualizados.
                        details
                            summary
                                | ¿Cómo accedo a la biblioteca digital?
                                +icon('chevron')
                            p
                                = 'Desde el botón “Explorar la biblioteca” de esta página. Se abrirá el sitio de la '
                                a(href='https://sites.google.com/view/bibliotecaescuelareynaldomern/biblioteca-digital', target='_blank', rel='noopener noreferrer') biblioteca digital en una pestaña nueva
                                | , donde podés consultar sus recursos.
        footer.site-footer
            .container.footer-top
                a.brand.footer-brand(href='#page-top')
                    img(src='assets/img/escudo.webp', width='48', height='48', alt='', loading='lazy')
                    span.brand-text
                        strong Reynaldo Merín
                        small ESCUELA TÉCNICA N.º 4-124
                p Aprender hoy. Construir el mañana.
                a.footer-top-link(href='#page-top') Volver arriba ↑
            .container.footer-bottom
                small= '© '
                    span#year 2026
                    |  Escuela Reynaldo Merín · San Rafael, Mendoza
                small Hecho para nuestra comunidad.
